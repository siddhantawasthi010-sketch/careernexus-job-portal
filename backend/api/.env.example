SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

EMAIL_PROVIDER=gmail

# Gmail SMTP (default active provider)
# IMPORTANT: for Gmail, use a Google App Password (16 characters), not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=replace-with-app-password
SMTP_FROM=your-email@gmail.com

# Mailtrap (for local development testing)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mailtrap-user
MAILTRAP_PASS=your-mailtrap-password
MAILTRAP_FROM=your-mailtrap-sender@example.com

PORT=5000

# Live public career-portal feeds (comma-separated board IDs; no API key required).
# Greenhouse defaults are verified and used when GREENHOUSE_BOARD_SLUGS is unset.
GREENHOUSE_BOARD_SLUGS=figma,cloudflare,datadog,duolingo,robinhood,anthropic,stripe,asana,mongodb
# Optional Lever company-site identifiers, for example: LEVER_COMPANY_SITES=company-one,company-two
LEVER_COMPANY_SITES=
