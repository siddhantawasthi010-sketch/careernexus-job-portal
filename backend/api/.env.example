SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters

EMAIL_PROVIDER=gmail

# Gmail SMTP (default active provider)
# IMPORTANT: for Gmail, use a Google App Password (16 characters), not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=replace-with-app-password
SMTP_FROM=your-email@gmail.com

# Mailtrap (for local development testing)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mailtrap-user
MAILTRAP_PASS=your-mailtrap-password
MAILTRAP_FROM=your-mailtrap-sender@example.com

PORT=5000
CORS_ORIGINS=http://localhost:5173

# Job feed integrations. Keep provider secrets in this backend-only file.
SERPAPI_API_KEY=
GOOGLE_JOBS_COUNTRY=in
GOOGLE_JOBS_LANGUAGE=en
GOOGLE_JOBS_MAX_LOCATIONS=1
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JOOBLE_API_KEY=
RAPIDAPI_KEY=

# Optional employer ATS board/site IDs; these are not the employer career URLs.
GREENHOUSE_BOARD_SLUGS=stripe,figma,cloudflare,datadog,airbnb
LEVER_COMPANY_SITES=veeva
# Public employer board identifiers, comma-separated.
ASHBY_JOB_BOARDS=
SMARTRECRUITERS_COMPANIES=AbstrabitTechnologiesPvtLtd,VMaxIndiaPvtLtd,BoschGroup,QADInc,TheNielsenCompany,TOPSInfosolutions1,SaggezzaIndiaPvtLtd1,PentozTechnology,T-SystemsICTIndiaPvtLtd1,Entain,eversana1,Version1,GPIndia,ifs1,Freshworks,AristaNetworks,servicenow,Intuit2,VizExperts,SopraSteria1,sia,NECSWS,ixigo,SWIGGY,EndeavorItSolutionsPvtLtd1,CheckPointSoftwareTechnologies2,MicroStrategy1,LinkTag,Altisource,Intersoftkk1,CareerNetTechnologiesPvtLtd1,WNSGlobalServices144,IEnergizerITServicesPvtLtd,TelliantSystemsIndiaPrivateLimited,IndSoftInc
SMARTRECRUITERS_MAX_POSTINGS=5
# JSON array of Workday tenant configurations, e.g.
# WORKDAY_TENANTS=[{"tenant":"nvidia","host":"nvidia.wd5.myworkdayjobs.com","site":"NVIDIAExternalCareerSite","company":"NVIDIA"},{"tenant":"accenture","host":"accenture.wd103.myworkdayjobs.com","site":"AccentureCareers","company":"Accenture"}]
