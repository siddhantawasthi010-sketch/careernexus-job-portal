SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

EMAIL_PROVIDER=gmail

# Gmail SMTP (default active provider)
# IMPORTANT: for Gmail, use a Google App Password (16 characters), not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=replace-with-app-password
SMTP_FROM=your-email@gmail.com

# Mailtrap (for local development testing)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your-mailtrap-user
MAILTRAP_PASS=your-mailtrap-password
MAILTRAP_FROM=your-mailtrap-sender@example.com

PORT=5000
CORS_ORIGINS=http://localhost:5173

# Job feed integrations. Keep provider secrets in this backend-only file.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JOOBLE_API_KEY=
RAPIDAPI_KEY=

# Optional employer ATS board/site IDs; these are not the employer career URLs.
GREENHOUSE_BOARD_SLUGS=stripe,figma,cloudflare,datadog,airbnb
LEVER_COMPANY_SITES=veeva
# JSON array of Workday tenant configurations, e.g.
# WORKDAY_TENANTS=[{"tenant":"nvidia","host":"nvidia.wd5.myworkdayjobs.com","site":"NVIDIAExternalCareerSite","company":"NVIDIA"},{"tenant":"accenture","host":"accenture.wd103.myworkdayjobs.com","site":"AccentureCareers","company":"Accenture"}]
WORKDAY_TENANTS=
